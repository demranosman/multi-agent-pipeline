# LLM Sağlayıcı API Anahtarları (En az biri veya kullanacağınız sağlayıcılar gereklidir)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...
DEEPSEEK_API_KEY=sk-...
GEMINI_API_KEY=AIzaSy...

# Opsiyonel - Fallback: birincil model kredi/limit/ağ hatası verirse denenecek modeller.
# Belirtilmezse otomatik: API anahtarı tanımlı diğer sağlayıcıların en üst modeli denenir.
# LLM_FALLBACK_MODELS=gemini-3.8-flash,gpt-6-luna

# Opsiyonel - SADECE Anthropic anahtarı belirli bir workspace'e bağlı DEĞİLSE gerekir
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Opsiyonel - Veritabanı URL (belirtilmezse ./pipeline.db SQLite kullanılır)
# DATABASE_URL=postgresql://user:pass@localhost:5432/agent_pipeline
